# 复制成 agent/.env 后按本机情况修改。所有变量都可以不填，走这里的默认值。
# 前缀统一是 AILS_，不设环境变量也能启动（Mock LLM + Fixture Retriever 可完全离线跑通）。

# ---------- HTTP 服务自身 ----------
AILS_HOST=127.0.0.1
AILS_PORT=8000

# ---------- 后端（Spring Boot）----------
# HTTP 检索模式会读这里的读接口；未传 authToken 时自动退回 Fixture。
AILS_BACKEND_BASE_URL=http://localhost:8080

# ---------- LLM ----------
# mock = 确定性假输出，离线可跑；openai = 任何 OpenAI 兼容服务
AILS_LLM_PROVIDER=mock
AILS_LLM_BASE_URL=https://api.deepseek.com/v1
AILS_LLM_API_KEY=
AILS_LLM_MODEL=deepseek-chat
AILS_LLM_TEMPERATURE=0.6
AILS_LLM_MAX_TOKENS=1024
AILS_LLM_TIMEOUT_SECONDS=60

# 阿里云百炼 / DashScope（OpenAI Chat Completions 兼容）示例：
# AILS_LLM_PROVIDER=openai
# AILS_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AILS_LLM_MODEL=qwen-plus
# AILS_LLM_TEMPERATURE=0.0
# AILS_LLM_API_KEY=<从环境变量或本机 .env 注入，不要提交>
# 缺少 Key 时 provider=openai 会直接启动失败，不会静默退回 mock。

# ---------- 检索 ----------
# auto = 有 authToken 走 HTTP，否则走 Fixture；http / fixture 可强制指定
AILS_RETRIEVER_MODE=auto
AILS_FIXTURE_PATH=fixtures/demo_space.json
AILS_MEMORY_TOP_K=5
AILS_KNOWLEDGE_TOP_K=5
# 只是初始可调起点，不是「答案正确」的阈值；换模型后必须用真实语料校准。
AILS_KNOWLEDGE_MIN_SCORE=0.35
# 白名单 + 查询向量 + Qdrant 检索的总时限（秒）。
AILS_KNOWLEDGE_TIMEOUT_SECONDS=15
AILS_EVIDENCE_TOP_K=3

# ---------- 分析 Worker（RabbitMQ）----------
# 只有 python -m app.worker 会用到；HTTP 服务不依赖 RabbitMQ。
# 必须与后端 ails.internal.token 一致；为空时 Worker 的检索会被后端拒绝。
AILS_INTERNAL_TOKEN=
# 与后端 spring.rabbitmq.* 指向同一个 broker
AILS_RABBITMQ_URL=amqp://guest:guest@localhost:5672/
AILS_RABBITMQ_PREFETCH=1
# 以下参数必须与后端 ails.analysis.mq.* 一致（默认值已经对齐）
# AILS_ANALYSIS_RETRY_TTL_MS=15000
# AILS_ANALYSIS_MAX_RETRIES=3

# ---------- 上下文预算 ----------
AILS_RECENT_HISTORY_LIMIT=12
AILS_MAX_CONTEXT_TOKENS=3000

# ---------- 文档解析 / 切块 ----------
# 必须不大于后端 ails.document.storage.max-size-bytes（默认 10 MiB）
AILS_DOCUMENT_MAX_BYTES=10485760
AILS_DOCUMENT_CHUNK_MAX_CHARS=1200
AILS_DOCUMENT_CHUNK_OVERLAP_CHARS=150
# 内部文档接口凭据，必须与后端 AILS_INTERNAL_TOKEN（ails.internal.token）一致。
# 为空时 /agent/documents/* 会 fail closed（503）。
# AILS_INTERNAL_TOKEN=

# ---------- Embedding ----------
# hash = 离线确定性向量，只能用于开发/测试；openai = OpenAI 兼容 /embeddings。
# 真实语义检索必须显式改成 openai 并配好模型、维度；失败时不会回退到 hash。
AILS_EMBEDDING_PROVIDER=hash
AILS_EMBEDDING_BASE_URL=https://api.openai.com/v1
AILS_EMBEDDING_API_KEY=
AILS_EMBEDDING_MODEL=text-embedding-3-small
# 必须与模型实际输出维度一致；hash-v1 默认使用 256 维。
AILS_EMBEDDING_DIMENSION=256
AILS_EMBEDDING_TIMEOUT_SECONDS=30
AILS_EMBEDDING_MAX_RETRIES=2
# 单次请求最大文本数；百炼 text-embedding-v4 上限为 10。
AILS_EMBEDDING_BATCH_SIZE=10

# 阿里云百炼 text-embedding-v4（OpenAI 兼容模式）示例：
# 北京：https://dashscope.aliyuncs.com/compatible-mode/v1
# 新加坡：https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# text-embedding-v4 默认输出 1024 维；collection 会自动带模型名和维度。
# AILS_EMBEDDING_PROVIDER=openai
# AILS_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AILS_EMBEDDING_MODEL=text-embedding-v4
# AILS_EMBEDDING_DIMENSION=1024
# AILS_EMBEDDING_BATCH_SIZE=10
# AILS_EMBEDDING_API_KEY=<从环境变量或本机 .env 注入，不要提交>


# ---------- Qdrant ----------
AILS_QDRANT_URL=http://127.0.0.1:6333
AILS_QDRANT_API_KEY=
AILS_QDRANT_TIMEOUT_SECONDS=30
# 实际 collection 名为 <prefix>_<model>_<dimension>
AILS_QDRANT_COLLECTION_PREFIX=ails_documents
AILS_QDRANT_UPSERT_BATCH_SIZE=64
