{"id": "verification-new-concept-ask-later", "category": "verification", "description": "首次接触一个概念且用户在提问时，只记 ASK_LATER，不打断教学", "engine": "heuristic", "request": {"userMessage": "缺页异常是什么？"}, "expect": {"detectedConcepts": ["缺页异常"], "verification.action": "ASK_LATER", "verification.trigger": "NEW_CONCEPT", "verification.conceptId": 12, "verification.questionType": "SHORT_ANSWER", "verification.questionText": {"op": "contains", "value": "缺页异常"}}}
{"id": "verification-known-concept-skip", "category": "verification", "description": "已有理解快照的概念不重复触发验证（TLB 在 fixture 里是 MISCONCEPTION）", "engine": "heuristic", "request": {"userMessage": "TLB Miss 之后呢？"}, "expect": {"detectedConcepts": ["TLB（快表）"], "verification.action": "SKIP"}}
{"id": "verification-explanation-skips", "category": "verification", "description": "用户在解释而不是提问时，不插入验证（这一轮的任务是把话说完）", "engine": "heuristic", "request": {"userMessage": "我理解 TLB 就是页表项的缓存。"}, "expect": {"verification.action": "SKIP"}}
{"id": "verification-recorded-ask-now-preserved", "category": "verification", "description": "模型给出 ASK_NOW 时，题型 / 题干 / 正确答案 / trigger 原样保留", "engine": "recorded", "request": {"userMessage": "TLB Miss 之后要做什么？"}, "llmResponse": {"verificationDecision": {"action": "ASK_NOW", "trigger": "REPEATED_ERROR", "conceptId": 10, "reason": "同一误区第二次出现", "questionType": "TRUE_FALSE", "questionText": "TLB Miss 等同于 Page Fault。", "correctAnswer": "错误"}}, "expect": {"verification.action": "ASK_NOW", "verification.trigger": "REPEATED_ERROR", "verification.conceptId": 10, "verification.questionType": "TRUE_FALSE", "verification.questionText": "TLB Miss 等同于 Page Fault。", "verification.reason": "同一误区第二次出现"}}
{"id": "verification-fabricated-concept-skipped", "category": "verification", "description": "验证决策引用未命中的概念时降级为 SKIP：宁可不出题，也不能给别的知识点出题", "engine": "recorded", "request": {"userMessage": "TLB Miss 之后要做什么？"}, "llmResponse": {"verificationDecision": {"action": "ASK_NOW", "trigger": "OVERCONFIDENCE", "conceptId": 999, "questionText": "请解释 TLB Miss 的代价。"}}, "expect": {"verification.action": "SKIP", "verification.conceptId": null}}
{"id": "verification-ask-now-default-question", "category": "verification", "description": "ASK_NOW 没给题干时补一个可作答的默认题，而不是静默降级成 SKIP", "engine": "recorded", "request": {"userMessage": "TLB Miss 之后要做什么？"}, "llmResponse": {"verificationDecision": {"action": "ASK_NOW", "trigger": "LONG_UNVERIFIED", "conceptId": 10}}, "expect": {"verification.action": "ASK_NOW", "verification.questionType": "SHORT_ANSWER", "verification.questionText": {"op": "contains", "value": "TLB"}}}
