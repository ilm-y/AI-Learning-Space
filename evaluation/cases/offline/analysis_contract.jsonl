{"id": "contract-empty-input", "category": "analysis_contract", "description": "空白消息直接返回空结果，不检索、不调用模型", "engine": "heuristic", "request": {"userMessage": "   "}, "expect": {"evidence.count": 0, "memory.count": 0, "proposal.present": false, "verification.action": "SKIP", "detectedConcepts": [], "analyzerVersion": "agent-v1"}}
